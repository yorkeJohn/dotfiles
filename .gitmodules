[submodule "zsh/.zsh/plugins/powerlevel10k"]
	path = zsh/.zsh/plugins/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k
[submodule "zsh/.zsh/plugins/zsh-autosuggestions"]
	path = zsh/.zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "zsh/.zsh/plugins/zsh-syntax-highlighting"]
	path = zsh/.zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting
[submodule "nvim/.config/nvim/pack/plugins/start/monokai.nvim"]
	path = nvim/.config/nvim/pack/plugins/start/monokai.nvim
	url = https://github.com/tanvirtin/monokai.nvim
[submodule "nvim/.config/nvim/pack/plugins/start/nvim-treesitter"]
	path = nvim/.config/nvim/pack/plugins/start/nvim-treesitter
	url = https://github.com/nvim-treesitter/nvim-treesitter
	branch = master
[submodule "nvim/.config/nvim/pack/plugins/start/nvim-tree.lua"]
	path = nvim/.config/nvim/pack/plugins/start/nvim-tree.lua
	url = https://github.com/nvim-tree/nvim-tree.lua
